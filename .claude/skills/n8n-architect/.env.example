# Skill n8n-architect — credenciais das 2 instâncias n8n
# Copia este arquivo pra .env (mesma pasta) e preenche os valores.
# .env NUNCA é commitado (gitignore protege).

# --- Instância PESSOAL ---
N8N_PESSOAL_URL=
N8N_PESSOAL_API_KEY=

# --- Instância LUMINUS ---
N8N_LUMINUS_URL=
N8N_LUMINUS_API_KEY=

# --- Versões (preenche depois de logar em cada n8n; rodapé da tela) ---
N8N_PESSOAL_VERSION=
N8N_LUMINUS_VERSION=
