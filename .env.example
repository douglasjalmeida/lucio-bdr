# Lúcio BDR — variáveis de ambiente (preencher em .env, NÃO versionar)

# ─────────────────────────────────────────────────────────────
# Claude Agent SDK
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Modelo (Sonnet 4.6 default; avaliar Haiku 4.5 após F2)
LUCIO_MODEL=claude-sonnet-4-6

# ─────────────────────────────────────────────────────────────
# iaSolution — API OFICIAL do WhatsApp (Meta Cloud API via BSP).
# Substitui a uazapi (chip não-oficial), aposentada.
#
# Inbound: aponte o webhook do canal no painel da iaSolution pra
#   <BRIDGE_PUBLIC_URL>/webhook/iasolution
# Outbound: o bridge chama /messages/text direto (sem n8n).
#
# LIMITE DA API OFICIAL: texto livre só sai dentro da janela de
# 24h desde a última mensagem do lead. Fora dela, só template
# aprovado pela Meta (HSM) — por isso o outbound frio ainda não
# migrou pra cá.
# ─────────────────────────────────────────────────────────────
IASOLUTION_BASE_URL=https://apihub.iasolution.app/api/v1
IASOLUTION_TOKEN=                   # Bearer do canal Luminus. Pegar no painel iaSolution.
IASOLUTION_TIMEOUT_MS=15000

# Número do próprio canal (E.164 sem +). Trava de segurança: evento cujo
# remetente seja a gente mesmo é ignorado, nunca vira lead nem fala de humano.
# Protege contra envelope em que o eco traz `from` = número do negócio.
IASOLUTION_NUMERO_NEGOCIO=

# Secret do webhook. VAZIO = endpoint aberto: qualquer um que descubra a URL
# faz o Lúcio responder (gastando LLM) ou força lead pra modo mudo.
# Configure no painel da iaSolution como header `x-webhook-secret` ou, se o
# painel só aceitar URL, use ?secret=<valor> no fim do webhook.
IASOLUTION_WEBHOOK_SECRET=

# Allowlist de teste (CSV, E.164 sem +). VAZIA = passa todo mundo (produção).
# Preencher só enquanto valida E2E, pra lead real não entrar no meio do teste.
# Ex: IASOLUTION_ALLOWLIST=554896990020
IASOLUTION_ALLOWLIST=

# ─────────────────────────────────────────────────────────────
# n8n — webhook do outbound cadenciado (LEGADO).
# O inbound não passa mais por n8n. Este é o único fio que sobrou,
# e ele ainda dispara pela uazapi. Vai morrer quando o outbound
# migrar pra template da API oficial.
# ─────────────────────────────────────────────────────────────
N8N_OUTBOUND_WEBHOOK_URL=     # WF-Lucio-Outbound (cadência batch via /sender/advanced)

# ─────────────────────────────────────────────────────────────
# Groq — Whisper pra transcrever PTT do lead (decisão D11).
# Roda no bridge (src/transcricao.js). Antes vivia no WF-Lucio-IN
# do n8n; veio pro Node junto com o parse do inbound.
# Sem chave, áudio do lead vira aviso genérico e o Lúcio pede texto.
# ─────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────
# Supabase — projeto novo dentro da conta Luminus existente
# Onde achar: Settings → API no painel do projeto Supabase
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=                       # Project URL
SUPABASE_SERVICE_ROLE_KEY=          # service_role (secret) — bridge usa essa pra bypassar RLS
SUPABASE_ANON_KEY=                  # anon public (não usada hoje, reservada pra futuro dashboard)

# Personal Access Token pro MCP Supabase do Modo Dev (Claude Code lendo schema/SQL ad-hoc).
# Onde achar: https://supabase.com/dashboard/account/tokens
# Diferente das chaves acima — é PAT da conta, não do projeto.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=               # ref do projeto (parte do URL: <ref>.supabase.co)

# MCP Supabase em read-only por default (1). Pra rodar migrations/seed via MCP,
# trocar pra 0, /mcp reconnect, aplicar, e voltar pra 1.
SUPABASE_MCP_READONLY=1

# ─────────────────────────────────────────────────────────────
# Chatwoot — opcional no MVP. Bridge tolera ausência:
# se CHATWOOT_BASE_URL vazio, tools Chatwoot ficam off e Lúcio
# segue operando só com Supabase + WhatsApp. Plugar em F3.
# ─────────────────────────────────────────────────────────────
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
# ID do team "Closers" no Chatwoot. Conversa qualificada é atribuída a ele no handoff.
CHATWOOT_CLOSERS_TEAM_ID=1
# Closers humanos: nome-da-etiqueta:agentId (CSV). Alimenta o round-robin do
# handoff (alterna entre os agents) e o override manual por etiqueta no Chatwoot
# (closer aplica a label do próprio nome → conversa é atribuída a ele).
# Ex: CHATWOOT_CLOSER_MAP=atend-gerson:12,atend-viviane:17
CHATWOOT_CLOSER_MAP=

# ─────────────────────────────────────────────────────────────
# Handoff — quando Lúcio qualifica MQL, dispara:
# (1) label + nota privada + atribuição team no Chatwoot
# (2) modo=mudo no Supabase (Lúcio para de responder)
# (3) notificação WhatsApp pessoal Douglas (opcional, via n8n)
# ─────────────────────────────────────────────────────────────
# Modelo do classificador post-resposta. Haiku é barato e suficiente.
LUCIO_QUALIFIER_MODEL=claude-haiku-4-5-20251001
# Webhook do fluxo [claudio] WF-Envio-WhatsApp-Pessoal no n8n pessoal.
# Payload: { numero, mensagem, tipo: "texto" }. Deixe vazio pra desligar notify.
N8N_HANDOFF_NOTIFY_URL=
# Número do Douglas pra receber alertas de handoff (E.164 sem +). Ex: 5511999999999
HANDOFF_NOTIFY_NUMERO=

# ─────────────────────────────────────────────────────────────
# Chatwoot → bridge webhook (Opção B — closer trabalha no Chatwoot,
# bridge dispara via uazapi).
# Crie webhook no Chatwoot apontando pra https://<bridge>/chatwoot-webhook,
# evento message_created. Opcional: secret HMAC pra validação.
# ─────────────────────────────────────────────────────────────
CHATWOOT_WEBHOOK_SECRET=
# URL pública do bridge (pra registrar webhook no Chatwoot). Em prod = URL Easypanel.
BRIDGE_PUBLIC_URL=

# ─────────────────────────────────────────────────────────────
# Bridge HTTP
# ─────────────────────────────────────────────────────────────
PORT=8788
NODE_ENV=development

# Buffer pra agrupar mensagens em rajada (lead manda 3 msgs seguidas → 1 resposta).
# Em segundos. 0 = desativa buffer (cada msg vira resposta imediata).
LUCIO_BUFFER_SECONDS=10

# ─────────────────────────────────────────────────────────────
# Outbound (cadência uazapi /sender/advanced)
# Jitter mínimo 3min (180s); janela 09–17h em dias úteis.
# ─────────────────────────────────────────────────────────────
OUTBOUND_DELAY_MIN_SEC=180
OUTBOUND_DELAY_MAX_SEC=480
OUTBOUND_WINDOW_START=08
OUTBOUND_WINDOW_END=17

# Bypass janela 09-17h (só pra testes). 1 = ignora janela e agenda no horário cru.
# IMPORTANTE: voltar pra 0 (ou remover) antes de soltar em produção.
CADENCE_IGNORAR_JANELA=0

# ─────────────────────────────────────────────────────────────
# Watchdog de handoff abandonado
# Se humano não responde uma msg do lead em TIMEOUT_MIN, Lúcio retoma
# automaticamente: gera resposta com histórico (inclui notas privadas) e envia.
# Respeita janela 09-17h. Idempotente via evento `lucio_retomou_auto`.
# ─────────────────────────────────────────────────────────────
WATCHDOG_TICK_SECONDS=300
WATCHDOG_HANDOFF_TIMEOUT_MIN=60



# F6 Dashboard (HTTP Basic Auth)
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# ─────────────────────────────────────────────────────────────
# CRM externo — funis Marketing (MQL) + Vendas (SQL) via API de
# token estático. Espelha cada transição que já vai pro Chatwoot.
# Opcional: se CRM_BASE_URL ou CRM_API_TOKEN vazio, o espelho fica
# off (no-op) e o pipeline segue normal. Best-effort: erro no CRM
# nunca quebra o registro da transição.
#   Marketing = card "lead"   (em-cadencia → mql-respondeu → mql-qualificado → mql-descartado)
#   Vendas    = card "negócio" (humano-atendendo → sql-contato-feito → sql-proposta → sql-negociacao → sql-ganho/sql-perdido)
# Depois de preencher: rode `node scripts/crm-setup.js` pra criar as etapas.
# ─────────────────────────────────────────────────────────────
CRM_BASE_URL=        # raiz do servidor, SEM /api no fim. Ex: https://crm.luminus.com.br
CRM_API_TOKEN=       # EXTERNAL_API_TOKEN (Bearer) gerado no servidor do CRM

# ─────────────────────────────────────────────────────────────
# Resend — email de campanha acoplado ao disparo do Lúcio (mesmo
# gatilho do toque WhatsApp, destinatário = o lead). Canais
# INDEPENDENTES: falha de email não derruba o WhatsApp e vice-versa.
#
# DRY-RUN POR DEFAULT: só envia de verdade com RESEND_DRY_RUN=false
# EXPLÍCITO. Sem isso (ou vazio), só loga o payload — nada sai.
# Conteúdo é parametrizável: assunto via template com {nome}/{empresa};
# corpo = o texto do toque. RESEND_API_KEY NUNCA vai pro git em claro.
# Obs: hoje os leads não têm campo de email, então o envio é pulado
# (skip:sem-destinatario) até existir fonte de email por lead.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=                 # re_... — só no .env (git-crypt), nunca commitar em claro
RESEND_FROM=                    # remetente verificado. Ex: Lúcio Luminus <lucio@luminusgeradores.com.br>
RESEND_SUBJECT_TEMPLATE=Luminus — sobre o seu contato   # aceita {nome} e {empresa}
RESEND_DRY_RUN=true             # 'false' (explícito) p/ enviar de verdade; qualquer outro valor = dry-run
RESEND_TIMEOUT_MS=8000
